# Copy this file to functions/.env and edit it, then redeploy: firebase deploy --only functions
# These two values are NOT secrets (the sender shows up in every email). API keys never go in this file.
#
# MAIL_FROM must be an address on a domain you have VERIFIED in Resend (Resend dashboard -> Domains).
# Do NOT use onboarding@resend.dev for real users: Resend only delivers that test sender to the email address
# of your own Resend account. The function refuses to send while this still contains the placeholder below.
MAIL_FROM="DSA Tracker <no-reply@your-verified-domain.com>"
APP_NAME="DSA Interview Problem Tracker"
